# 내 PC가 기본값(3307 / donworry / donworry)과 다를 때만 채운다
# 이 파일을 복사해 application-local.yml 로 이름을 바꾼다 (git 제외)
# CakeShop HMAC 키는 YAML에 넣지 않는다. 실행 프로세스 환경변수
# DONWORRY_MERCHANT_HMAC_CAKESHOP으로 주입한다 (docs/identity/246-cakeshop-provisioning.md).
spring:
  datasource:
    url: jdbc:mariadb://localhost:3306/donworry
    username: donworry
    password: 내비밀번호

# 로컬 시연용 (docs/demo/local-demo.md 2 · 3절) — 필요할 때 주석을 풀어 쓴다
# payment:
#   http:
#     enabled: true            # CakeShop 서명 결제 API 켜기 (기본 꺼짐)
# ai:
#   server:
#     enabled: true            # 고정 보고서 대신 ai-server에 조사를 맡김 (기본 꺼짐)
#     api-key: "내AI서버키"       # ai-server/.env의 AI_SERVER_INTERNAL_API_KEY와 같은 값
