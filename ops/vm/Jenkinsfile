// 기존 donworry-cd-dryrun Job과 분리해 설치한다. webhook/pollSCM 트리거는 두지 않는다.
def vmCommand(String command) {
    if (!(command ==~ /[A-Za-z0-9_.@ -]+/)) {
        error('VM 명령 인자 형식 오류')
    }
    def output
    withCredentials([sshUserPrivateKey(
        credentialsId: 'donworry-vm1-deploy-ssh',
        keyFileVariable: 'VM1_SSH_KEY', usernameVariable: 'VM1_SSH_USER'
    )]) {
        withEnv(["CD_COMMAND=${command}"]) {
            output = sh(returnStdout: true, script: '''
                set +x
                set -eu
                ssh -i "$VM1_SSH_KEY" \
                  -o IdentitiesOnly=yes -o BatchMode=yes \
                  -o StrictHostKeyChecking=yes \
                  -o UserKnownHostsFile=/var/lib/jenkins/.ssh/known_hosts_donworry_vm1 \
                  -o ConnectTimeout=5 \
                  -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
                  "$VM1_SSH_USER@192.168.0.212" \
                  "sudo -n /usr/local/sbin/donworry-release $CD_COMMAND"
            ''').trim()
        }
    }
    return output
}

pipeline {
    agent any
    parameters {
        string(name: 'TARGET_SHA', defaultValue: '', description: '배포할 main SHA (소문자 hex 40자리)')
    }
    options {
        disableConcurrentBuilds()
        // 전체 timeout을 두지 않는다. 승인을 늦게 하면 배포 시간이 줄어 적용 도중 중단될 수 있어
        // 준비·승인 대기·적용에 각각 제한을 둔다.
        skipDefaultCheckout()
    }
    stages {
        stage('Prepare Pinned Bundle') {
            // VM 공통 잠금 대기 최대 5분도 포함한다.
            options { timeout(time: 30, unit: 'MINUTES') }
            steps {
                script {
                    if (!(params.TARGET_SHA ==~ /[0-9a-f]{40}/)) {
                        error('TARGET_SHA 형식 오류')
                    }
                    env.CD_EXECUTION = "${env.BUILD_NUMBER}-${java.util.UUID.randomUUID()}"
                    def summary = vmCommand("prepare ${params.TARGET_SHA} ${env.CD_EXECUTION}")
                    def bundle = new groovy.json.JsonSlurperClassic().parseText(summary)
                    if (!(bundle.bundle_id ==~ /[0-9a-f]{64}/) ||
                        bundle.sha != params.TARGET_SHA || bundle.execution != env.CD_EXECUTION) {
                        error('VM 준비 응답 불일치')
                    }
                    env.CD_BUNDLE = bundle.bundle_id
                    writeFile(file: 'release-bundle.json', text: summary)
                    archiveArtifacts(artifacts: 'release-bundle.json', fingerprint: true)
                    echo summary
                }
            }
        }
        stage('Approve Exact Bundle') {
            steps {
                script {
                    // digest와 구성 해시만 있는 요약이다. 실제 환경값은 VM에서만 보관한다.
                    // 승인 대기에만 제한을 둔다. 시간이 지나면 VM에 승인 기록 없이 끝난다.
                    def approver
                    timeout(time: 30, unit: 'MINUTES') {
                        approver = input(
                            message: "VM1 업데이트를 승인합니까?\n${readFile('release-bundle.json')}",
                            ok: '이 묶음으로 업데이트 승인', submitter: 'jenkins-admin',
                            submitterParameter: 'APPROVED_BY'
                        )
                    }
                    if (!(approver instanceof String) || !(approver ==~ /[A-Za-z0-9_.@-]{1,120}/)) {
                        error('승인자 응답 오류')
                    }
                    timeout(time: 10, unit: 'MINUTES') {
                        vmCommand("approve ${env.CD_BUNDLE} ${env.CD_EXECUTION} ${approver}")
                    }
                }
            }
        }
        stage('Verify And Update VM1') {
            // 잠금 5분·원격 재검증 2회·pull 3회·Compose/기동 검사의 VM 제한을 포함한다.
            // SSH/이 stage의 중단이 VM 작업 종료를 의미하지 않는다. 자동 재시도하지 않는다.
            // #483: 이전 배포 확인·DB 백업 15분·기능 검사 예산도 포함한다.
            options { timeout(time: 150, unit: 'MINUTES') }
            steps {
                script {
                    def result = vmCommand("apply ${env.CD_BUNDLE} ${env.CD_EXECUTION}")
                    def parsed = new groovy.json.JsonSlurperClassic().parseText(result)
                    if (parsed.status != 'success' || parsed.bundle_id != env.CD_BUNDLE ||
                        parsed.execution != env.CD_EXECUTION) {
                        error('VM 적용 결과 불일치')
                    }
                    writeFile(file: 'release-result.json', text: result)
                    archiveArtifacts(artifacts: 'release-result.json', fingerprint: true)
                    echo result
                }
            }
        }
    }
    post {
        success { echo 'CD_UPDATE_SUCCESS' }
        unsuccessful {
            echo 'CD_UPDATE_NOT_SUCCESSFUL: SSH/Jenkins 중단만으로 VM 종료·잠금 해제를 판단하지 마세요. releases/<bundle>/result.json 및 PAUSE_CD를 확인하고 donworry-release inspect로 실제 상태를 점검하세요. 이미지 복구는 운영자 확인 후 approve-recovery/recover로 별도 승인합니다. DB 복원·자동 재시도·자동 복구 없음.'
        }
    }
}
