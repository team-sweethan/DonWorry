# 복사해서 .env 로 쓴다 (git 제외). 값은 여기에 적지 않는다
# mock: Ollama 없이 정해진 순서로 조사 / ollama: Qwen 사용
AI_SERVER_LLM_PROVIDER=mock
AI_SERVER_LLM_API_KEY=
AI_SERVER_OLLAMA_BASE_URL=http://localhost:11434
AI_SERVER_OLLAMA_MODEL=qwen2.5:7b
# Spring 내부 Tool API 주소 · 서비스 키 (키 값은 여기에 적지 않는다)
AI_SERVER_SPRING_BASE_URL=http://localhost:8081
AI_SERVER_INTERNAL_API_KEY=
